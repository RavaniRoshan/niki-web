{
  "name": "@niki/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "next build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "start": "node scripts/static-server.mjs out 4321",
    "lint": "eslint .",
    "format": "prettier --write \"eslint.config.mjs\" \"playwright.config.ts\" \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"eslint.config.mjs\" \"playwright.config.ts\" \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\"",
    "test:serve": "node scripts/static-server.mjs out 4322",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@niki/theme": "0.1.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
