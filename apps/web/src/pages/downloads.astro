---
import PageHeader from "../components/PageHeader.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { RELEASE, TARGETS, INSTALLERS, CHECKSUMS } from "../data/release";
import { DOCS_ROUTES, docsUrl } from "@niki/theme/site";

const byOs = ["macOS", "Linux", "Windows"] as const;
const osMeta: Record<string, { icon: string; desc: string }> = {
  macOS: { icon: "", desc: "Apple Silicon & Intel · Homebrew or installer" },
  Linux: { icon: "", desc: "x86_64 & ARM64 · installer script or direct download" },
  Windows: { icon: "", desc: "x86_64 · PowerShell installer or direct download" },
};
---

<PageHeader
  eyebrow="Downloads"
  title={`Niki ${RELEASE.version}`}
  description={`Current stable release, ${RELEASE.date}. Static binaries built by cargo-dist — checksum-verified. One Rust binary, no runtime, no daemon.`}
  canonicalPath="/downloads"
>
  <div class="nk-pagehead__actions" slot="actions">
    <a class="nk-btn nk-btn--primary" href={docsUrl(DOCS_ROUTES.installation)}>Install docs</a>
    <a class="nk-btn nk-btn--secondary" href={RELEASE.notes}>Release notes</a>
  </div>
</PageHeader>

<section class="nk-section nk-container">
  <div class="nk-dl-banner">
    <div>
      <span class="nk-eyebrow">Quick install</span>
      <h2>One command, checksum-verified.</h2>
      <p>
        Pick your platform — the installer resolves the latest release and verifies SHA256 before
        installing.
      </p>
    </div>
    <div class="nk-dl-installers">
      {
        [INSTALLERS.shell, INSTALLERS.powershell].map((inst) => (
          <CodeBlock label={inst.label} code={inst.command} />
        ))
      }
    </div>
  </div>

  <div class="nk-dl-pm">
    <div>
      <h3>Package managers</h3>
      <div class="nk-dl-pm-list">
        <CodeBlock label="Homebrew (macOS/Linux)" code={INSTALLERS.homebrew.command} />
        <CodeBlock label="Cargo (from source)" code={INSTALLERS.cargo.command} />
      </div>
      <p class="nk-dl-pm-note">{INSTALLERS.homebrew.note} {INSTALLERS.cargo.note}</p>
    </div>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="targets-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">Direct downloads</p>
    <h2 id="targets-heading">Binaries for every target</h2>
    <p>
      {RELEASE.version} ({RELEASE.tag}, {RELEASE.date}) — every archive has a
      <code class="nk-inline">.sha256</code> sidecar; verify with
      <code class="nk-inline">sha256sum -c</code>.
    </p>
  </div>

  {
    byOs.map((os) => (
      <div class="nk-dl-os">
        <h3 class="nk-dl-os-title">{os}</h3>
        <p class="nk-dl-os-desc">{osMeta[os].desc}</p>
        <div class="nk-dl-rows">
          {TARGETS.filter((t) => t.os === os).map((t) => (
            <a
              class="nk-dl-row"
              href={`${RELEASE.repoBase}/releases/download/${RELEASE.tag}/${t.archive}.${t.archiveExt}`}
              rel="noopener noreferrer"
            >
              <span class="nk-dl-row__label">{t.label}</span>
              <span class="nk-dl-row__triple nk-mono">{t.triple}</span>
              <span class="nk-dl-row__meta nk-mono">.{t.archiveExt} · sha256 ✓</span>
              <span class="nk-dl-row__arrow" aria-hidden="true">
                download
              </span>
            </a>
          ))}
        </div>
      </div>
    ))
  }

  <div class="nk-dl-checksums">
    <a class="nk-btn nk-btn--secondary" href={CHECKSUMS.bundle} rel="noopener noreferrer">
      Download sha256.sum
    </a>
    <p>{CHECKSUMS.note}</p>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="verify-heading">
  <div class="nk-split">
    <div>
      <p class="nk-eyebrow">Integrity</p>
      <h2 id="verify-heading">Verify your download.</h2>
      <p>
        The installer verifies checksums automatically. For direct downloads, verify against the
        release checksums before trusting the binary:
      </p>
    </div>
    <CodeBlock
      label="manual verification"
      code={`curl -fsSLO ${RELEASE.repoBase}/releases/download/${RELEASE.tag}/sha256.sum
sha256sum -c sha256.sum --ignore-missing`}
    />
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="next-heading">
  <div class="nk-cta-final">
    <h2 id="next-heading">Installed. What's next?</h2>
    <p>Three commands to your first verified branch — no container runtime required to start:</p>
    <CodeBlock
      label="first run (worktree backend — no container needed)"
      code={`niki init --interactive
niki run "Add a /health endpoint" --backend worktree
niki report <id>   # the full audit trail`}
    />
    <div class="nk-cta-final__actions">
      <a class="nk-btn nk-btn--primary" href={docsUrl(DOCS_ROUTES.quickstart)}>Full quickstart</a>
      <a class="nk-btn nk-btn--secondary" href={docsUrl(DOCS_ROUTES.installation)}>Install docs</a>
    </div>
  </div>
</section>

<style>
  .nk-dl-banner {
    display: grid;
    gap: var(--nk-space-3);
    padding: var(--nk-space-4);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .nk-dl-banner {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--nk-space-6);
      padding: var(--nk-space-5);
    }
  }

  .nk-dl-banner h2 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }

  .nk-dl-installers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--nk-space-2);
  }

  .nk-dl-pm {
    margin-top: var(--nk-space-4);
  }

  .nk-dl-pm h3 {
    margin-bottom: var(--nk-space-2);
  }

  .nk-dl-pm-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--nk-space-2);
  }

  @media (min-width: 900px) {
    .nk-dl-pm-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nk-dl-pm-note {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--nk-text-muted);
  }

  .nk-dl-os {
    margin-bottom: var(--nk-space-5);
  }

  .nk-dl-os-title {
    font-size: 1.25rem;
    margin-bottom: 4px;
  }

  .nk-dl-os-desc {
    font-size: 0.875rem;
    color: var(--nk-text-muted);
    margin-bottom: var(--nk-space-2);
  }

  .nk-dl-rows {
    display: grid;
    gap: 10px;
  }

  .nk-dl-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "label arrow"
      "meta arrow";
    gap: 2px 16px;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    color: var(--nk-text-primary);
    transition: border-color 0.15s ease;
  }

  @media (min-width: 768px) {
    .nk-dl-row {
      grid-template-columns: 1.2fr 1fr auto auto;
      grid-template-areas: "label triple meta arrow";
      gap: var(--nk-space-2);
    }
  }

  .nk-dl-row:hover {
    text-decoration: none;
    border-color: color-mix(in srgb, var(--nk-mint) 45%, var(--nk-surface-border));
  }

  .nk-dl-row__label {
    grid-area: label;
    font-weight: 500;
  }

  .nk-dl-row__triple {
    grid-area: triple;
    font-size: 0.75rem;
    color: var(--nk-text-muted);
  }

  .nk-dl-row__meta {
    grid-area: meta;
    font-size: 0.75rem;
    color: var(--nk-mint);
  }

  .nk-dl-row__arrow {
    grid-area: arrow;
    font-family: var(--nk-font-mono);
    font-size: 0.75rem;
    color: var(--nk-mint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nk-dl-checksums {
    margin-top: var(--nk-space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nk-space-2);
  }

  .nk-dl-checksums p {
    font-size: 0.8125rem;
    color: var(--nk-text-muted);
  }

  .nk-split {
    display: grid;
    gap: var(--nk-space-4);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .nk-split {
      grid-template-columns: 1fr 1fr;
      gap: var(--nk-space-6);
    }
  }

  .nk-split h2 {
    margin-bottom: var(--nk-space-2);
  }

  .nk-split > div > p {
    margin-top: var(--nk-space-2);
  }

  .nk-cta-final {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--nk-space-2);
  }

  .nk-cta-final > p {
    color: var(--nk-text-secondary);
  }

  .nk-cta-final .nk-codeblock {
    text-align: left;
    max-width: 640px;
    width: 100%;
    margin-top: var(--nk-space-2);
  }

  .nk-cta-final__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--nk-space-1);
    margin-top: var(--nk-space-2);
  }
</style>
