---
import PageHeader from "../../components/PageHeader.astro";
import { WEB_ROUTES, DOCS_ROUTES, docsUrl, SITE } from "@niki/theme/site";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageHeader
  eyebrow="Resources"
  title="Guides, articles and release notes."
  description="Everything we've written about running, extending and understanding Niki — from your first verified branch to per-agent provider tuning."
  canonicalPath="/resources"
/>

<section class="nk-section nk-container">
  <div class="nk-res-grid">
    <a class="nk-card nk-res-card" href={WEB_ROUTES.blog}>
      <h3>Blog</h3>
      <p>
        Architecture deep-dives and design reasoning — why four agents, and why independence is
        enforceable.
      </p>
      <span class="nk-res-count">{blog.length} article{blog.length === 1 ? "" : "s"}</span>
    </a>
    <a class="nk-card nk-res-card" href={WEB_ROUTES.changelog}>
      <h3>Changelog</h3>
      <p>
        Every release, generated from GitHub Releases — what shipped, what changed, what got fixed.
      </p>
      <span class="nk-res-count">v{SITE.release.version} latest</span>
    </a>
    <a class="nk-card nk-res-card" href={WEB_ROUTES.guides}>
      <h3>Guides</h3>
      <p>Step-by-step walkthroughs — first verified branch, provider mixing, sandbox setup.</p>
    </a>
    <a class="nk-card nk-res-card" href={WEB_ROUTES.examples}>
      <h3>Examples</h3>
      <p>
        Real task descriptions that run well through the pipeline, with what each agent produces.
      </p>
    </a>
    <a class="nk-card nk-res-card" href={docsUrl(DOCS_ROUTES.evals)}>
      <h3>Evals methodology</h3>
      <p>How Niki audits its own claims — the seeded-defect harness and disclosure manifests.</p>
    </a>
    <a class="nk-card nk-res-card" href={docsUrl(DOCS_ROUTES.home)}>
      <h3>Documentation</h3>
      <p>The full reference: pipeline, sandboxing, providers, CLI, configuration.</p>
    </a>
  </div>

  <div class="nk-res-latest" aria-labelledby="latest-heading">
    <h2 id="latest-heading">Latest writing</h2>
    <div class="nk-res-latest-list">
      {
        blog.slice(0, 3).map((post) => (
          <a class="nk-res-post" href={`/resources/blog/${post.id}`}>
            <span class="nk-res-post__date nk-mono">
              {post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
            <span class="nk-res-post__title">{post.data.title}</span>
            <span class="nk-res-post__desc">{post.data.description}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .nk-res-grid {
    display: grid;
    gap: var(--nk-space-2);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .nk-res-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .nk-res-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .nk-res-card {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .nk-res-card p {
    margin: 0;
  }

  .nk-res-count {
    font-family: var(--nk-font-mono);
    font-size: 0.75rem;
    color: var(--nk-mint);
  }

  .nk-res-latest {
    margin-top: var(--nk-space-8);
  }

  .nk-res-latest h2 {
    font-size: 1.5rem;
    margin-bottom: var(--nk-space-3);
  }

  .nk-res-latest-list {
    display: grid;
    gap: var(--nk-space-2);
    max-width: 720px;
  }

  .nk-res-post {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "date title"
      "date desc";
    column-gap: var(--nk-space-2);
    row-gap: 4px;
    padding: var(--nk-space-2);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    color: var(--nk-text-primary);
    transition: border-color 0.15s ease;
  }

  .nk-res-post:hover {
    text-decoration: none;
    border-color: color-mix(in srgb, var(--nk-mint) 45%, var(--nk-surface-border));
  }

  .nk-res-post__date {
    grid-area: date;
    font-size: 0.75rem;
    color: var(--nk-mint);
    align-self: start;
    padding-top: 2px;
  }

  .nk-res-post__title {
    grid-area: title;
    font-weight: 600;
  }

  .nk-res-post__desc {
    grid-area: desc;
    font-size: 0.875rem;
    color: var(--nk-text-muted);
  }
</style>
