---
import PageHeader from "../../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageHeader
  eyebrow="Resources · Blog"
  title="Writing about Niki."
  description="Architecture reasoning, release breakdowns and design decisions — the why behind the pipeline."
  canonicalPath="/resources/blog"
/>

<section class="nk-section nk-container">
  <div class="nk-blog-list">
    {
      posts.map((post) => (
        <a class="nk-blog-card" href={`/resources/blog/${post.id}`}>
          <div class="nk-blog-card__meta">
            <time class="nk-mono" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            {post.data.tags.map((tag) => (
              <span class="nk-badge">{tag}</span>
            ))}
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <span class="nk-link-arrow">Read</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .nk-blog-list {
    display: grid;
    gap: var(--nk-space-2);
    max-width: 760px;
  }

  .nk-blog-card {
    display: grid;
    gap: var(--nk-space-1);
    padding: var(--nk-space-3);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    color: var(--nk-text-primary);
    transition: border-color 0.15s ease;
  }

  .nk-blog-card:hover {
    text-decoration: none;
    border-color: color-mix(in srgb, var(--nk-mint) 45%, var(--nk-surface-border));
  }

  .nk-blog-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nk-blog-card__meta time {
    font-size: 0.75rem;
    color: var(--nk-mint);
  }

  .nk-blog-card h2 {
    font-size: 1.375rem;
  }

  .nk-blog-card p {
    color: var(--nk-text-muted);
    font-size: 0.9375rem;
  }
</style>
