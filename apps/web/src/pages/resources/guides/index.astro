---
import PageHeader from "../../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageHeader
  eyebrow="Resources · Guides"
  title="Guides."
  description="Step-by-step walkthroughs for the workflows that matter: first runs, provider tuning, sandbox hardening."
  canonicalPath="/resources/guides"
/>

<section class="nk-section nk-container">
  <div class="nk-guide-list">
    {
      guides.map((guide) => (
        <a class="nk-guide-card" href={`/resources/guides/${guide.id}`}>
          <div class="nk-guide-card__head">
            <h2>{guide.data.title}</h2>
            <div class="nk-guide-card__tags">
              <span class="nk-badge">{guide.data.difficulty}</span>
              {guide.data.time && <span class="nk-badge">{guide.data.time}</span>}
            </div>
          </div>
          <p>{guide.data.description}</p>
          <span class="nk-link-arrow">Read guide</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .nk-guide-list {
    display: grid;
    gap: var(--nk-space-2);
    max-width: 760px;
  }

  .nk-guide-card {
    display: grid;
    gap: var(--nk-space-1);
    padding: var(--nk-space-3);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    color: var(--nk-text-primary);
    transition: border-color 0.15s ease;
  }

  .nk-guide-card:hover {
    text-decoration: none;
    border-color: color-mix(in srgb, var(--nk-mint) 45%, var(--nk-surface-border));
  }

  .nk-guide-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--nk-space-1);
  }

  .nk-guide-card__head h2 {
    font-size: 1.25rem;
  }

  .nk-guide-card__tags {
    display: flex;
    gap: 8px;
  }

  .nk-guide-card p {
    color: var(--nk-text-muted);
    font-size: 0.9375rem;
  }
</style>
