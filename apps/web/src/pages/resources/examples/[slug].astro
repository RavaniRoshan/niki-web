---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { render, getCollection } from "astro:content";
import { WEB_ROUTES } from "@niki/theme/site";

export async function getStaticPaths() {
  const posts = await getCollection("examples");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/resources/examples/${post.id}`}
>
  <article class="nk-ex nk-container">
    <header class="nk-ex__head">
      <a class="nk-back nk-mono" href={WEB_ROUTES.examples}>← all examples</a>
      <div class="nk-ex__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <span>·</span>
        <span class="nk-badge">{post.data.difficulty}</span>
        {post.data.stack.map((s) => <span class="nk-badge">{s}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <p class="nk-ex__desc">{post.data.description}</p>
    </header>
    <div class="nk-prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .nk-ex {
    padding-block: var(--nk-space-8) var(--nk-space-10);
    max-width: 760px;
  }

  .nk-back {
    color: var(--nk-mint);
    font-size: 0.8125rem;
  }

  .nk-ex__meta {
    display: flex;
    gap: 8px;
    margin-top: var(--nk-space-2);
    font-size: 0.875rem;
    color: var(--nk-text-muted);
  }

  .nk-ex__head h1 {
    margin-top: var(--nk-space-2);
  }

  .nk-ex__desc {
    margin-top: var(--nk-space-2);
    font-size: 1.125rem;
    color: var(--nk-text-secondary);
  }

  .nk-prose {
    margin-top: var(--nk-space-5);
  }

  .nk-prose :global(h2) {
    font-size: 1.5rem;
    margin: var(--nk-space-5) 0 var(--nk-space-2);
    padding-top: var(--nk-space-3);
    border-top: 1px solid var(--nk-surface-border);
  }

  .nk-prose :global(p) {
    margin: var(--nk-space-2) 0;
    color: var(--nk-text-secondary);
    line-height: 1.7;
  }

  .nk-prose :global(a) {
    color: var(--nk-mint);
  }

  .nk-prose :global(code) {
    font-family: var(--nk-font-mono);
    font-size: 0.85em;
    background: color-mix(in srgb, var(--nk-mint) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--nk-mint) 14%, transparent);
    color: var(--nk-mint);
    padding: 0.15em 0.4em;
    border-radius: 6px;
  }

  .nk-prose :global(pre) {
    background: var(--nk-bg-2);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-code);
    padding: var(--nk-space-2);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .nk-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: var(--nk-text-secondary);
  }

  .nk-prose :global(strong) {
    color: var(--nk-text-primary);
  }
</style>
