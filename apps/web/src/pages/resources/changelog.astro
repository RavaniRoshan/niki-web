---
import PageHeader from "../../components/PageHeader.astro";
import { RELEASES } from "../../data/changelog";
import { SITE } from "@niki/theme/site";
---

<PageHeader
  eyebrow="Resources · Changelog"
  title="Every release, every change."
  description="Niki's changelog, generated from the repository's CHANGELOG.md and GitHub Releases. Honest by construction — shipped means shipped."
  canonicalPath="/resources/changelog"
/>

<section class="nk-section nk-container">
  <div class="nk-ch-list">
    {
      RELEASES.map((rel, idx) => (
        <article class:list={["nk-ch-release", idx === 0 && "is-latest"]} id={`v${rel.version}`}>
          <header class="nk-ch-release__head">
            <h2>
              <a href={rel.url}>v{rel.version}</a>
            </h2>
            {idx === 0 && <span class="nk-badge nk-badge--mint">latest</span>}
            <time class="nk-mono" datetime={rel.date}>
              {rel.date}
            </time>
          </header>
          {rel.summary && <p class="nk-ch-release__summary">{rel.summary}</p>}
          <div class="nk-ch-release__cats">
            {rel.categories.map((cat) => (
              <div class="nk-ch-cat">
                <h3 class="nk-mono">{cat.name}</h3>
                <ul>
                  {cat.items.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <p class="nk-ch-more">
    Full history on <a href={`${SITE.repo}/releases`}>GitHub Releases</a> and the
    <a href={`${SITE.repo}/blob/master/CHANGELOG.md`}>CHANGELOG.md</a> in the repository.
  </p>
</section>

<style>
  .nk-ch-list {
    display: grid;
    gap: var(--nk-space-5);
    max-width: 820px;
  }

  .nk-ch-release {
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    padding: var(--nk-space-3);
  }

  .nk-ch-release.is-latest {
    border-color: color-mix(in srgb, var(--nk-mint) 40%, var(--nk-surface-border));
  }

  .nk-ch-release__head {
    display: flex;
    align-items: center;
    gap: var(--nk-space-1);
    flex-wrap: wrap;
  }

  .nk-ch-release__head h2 {
    font-size: 1.375rem;
  }

  .nk-ch-release__head h2 a {
    color: var(--nk-text-primary);
  }

  .nk-ch-release__head h2 a:hover {
    color: var(--nk-mint);
    text-decoration: none;
  }

  .nk-ch-release__head time {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--nk-text-muted);
  }

  .nk-ch-release__summary {
    margin-top: var(--nk-space-2);
    color: var(--nk-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .nk-ch-release__cats {
    margin-top: var(--nk-space-3);
    display: grid;
    gap: var(--nk-space-3);
  }

  .nk-ch-cat h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nk-mint);
    margin-bottom: var(--nk-space-1);
    font-weight: 600;
  }

  .nk-ch-cat ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .nk-ch-cat li {
    position: relative;
    padding-left: 18px;
    color: var(--nk-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .nk-ch-cat li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--nk-mint);
    font-family: var(--nk-font-mono);
    font-size: 0.75rem;
    top: 2px;
  }

  .nk-ch-cat li :global(code) {
    font-family: var(--nk-font-mono);
    font-size: 0.85em;
    background: color-mix(in srgb, var(--nk-mint) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--nk-mint) 14%, transparent);
    color: var(--nk-mint);
    padding: 0.1em 0.4em;
    border-radius: 6px;
  }

  .nk-ch-more {
    margin-top: var(--nk-space-4);
    font-size: 0.875rem;
    color: var(--nk-text-muted);
  }
</style>
