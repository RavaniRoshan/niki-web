---
import PageHeader from "../../components/PageHeader.astro";
import ProductSubNav from "../../components/ProductSubNav.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { DOCS_ROUTES, docsUrl } from "@niki/theme/site";

const providers = [
  "Anthropic",
  "OpenAI",
  "Google",
  "Ollama",
  "OpenRouter",
  "OpenCode Zen",
  "Kimi Code",
  "KiloCode",
  "NVIDIA",
  "Groq",
  "Together",
  "DeepSeek",
];
---

<PageHeader
  eyebrow="Product · Integrations"
  title="Bring your own everything."
  description="Twelve LLM providers, any OpenAI/Anthropic-compatible gateway, MCP servers, IDE clients via ACP, and OTLP observability — wired into the same pipeline without lock-in."
  canonicalPath="/product/integrations"
>
  <div class="nk-pagehead__actions" slot="actions">
    <a class="nk-btn nk-btn--primary" href={docsUrl(DOCS_ROUTES.providers)}>Providers docs</a>
  </div>
</PageHeader>

<ProductSubNav />

<section class="nk-section nk-container" aria-labelledby="providers-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">Providers</p>
    <h2 id="providers-heading">Per-agent provider mixing.</h2>
    <p>
      Point each agent at the provider and model that fits its job. A strong reasoner for Planner
      and Reviewer, a cheap model for the Tester — or everything local on Ollama.
    </p>
  </div>
  <div class="nk-int-grid">
    <CodeBlock
      label="niki.toml — mix freely"
      lang="toml"
      code={`[agents.planner]
provider = "anthropic"
model    = "claude-sonnet-4-20250514"

[agents.coder]
provider = "anthropic"
model    = "claude-sonnet-4-20250514"

[agents.tester]
provider = "openai"
model    = "gpt-4o-mini"     # cheap model for test generation

[agents.reviewer]
provider = "anthropic"
model    = "claude-sonnet-4-20250514"`}
    />
    <div class="nk-int-side">
      <h3>Keys & overrides</h3>
      <ul class="nk-checklist">
        <li>
          Keys from <code class="nk-inline">niki.toml</code> or env — <code class="nk-inline"
            >&lt;PROVIDER&gt;_API_KEY</code
          >, env wins
        </li>
        <li>
          <code class="nk-inline">_BASE_URL</code> / <code class="nk-inline">_MODEL</code> env overrides
          for gateway routing
        </li>
        <li>
          Any OpenAI- or Anthropic-compatible gateway via <code class="nk-inline">base_url</code>
        </li>
        <li><code class="nk-inline">niki providers</code> checks every configured provider</li>
        <li>
          <code class="nk-inline">niki recommend</code> suggests per-agent models from your own past spend
        </li>
      </ul>
    </div>
  </div>
  <ul class="nk-provider-list" role="list" aria-label="Supported LLM providers">
    {providers.map((p) => <li>{p}</li>)}
  </ul>
</section>

<section class="nk-section nk-container" aria-labelledby="mcp-heading">
  <div class="nk-split">
    <div>
      <p class="nk-eyebrow">MCP</p>
      <h2 id="mcp-heading">Model Context Protocol servers.</h2>
      <p>
        Wire MCP servers into agent context through
        <code class="nk-inline">[mcp]</code> — both stdio and Streamable-HTTP remote transports (JSON
        and SSE, with session affinity). Tools from your MCP servers join the same permission-gated runtime
        as Niki's baseline tools.
      </p>
      <p class="nk-after">
        <a class="nk-link-arrow" href={docsUrl("/configuration/config-file-guide")}
          >MCP configuration</a
        >
      </p>
    </div>
    <CodeBlock
      label="niki.toml — [mcp]"
      lang="toml"
      code={`[mcp.servers.search]
type    = "streamable-http"
url     = "https://mcp.example.com/mcp"
enabled = true

[mcp.servers.repo-tools]
type    = "stdio"
command = "npx"
args    = ["-y", "@example/repo-tools"]`}
    />
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="ide-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">Editors & CI</p>
    <h2 id="ide-heading">Wherever you work.</h2>
    <p>One pipeline, three surfaces — interactive, in-editor, and headless automation:</p>
  </div>
  <div class="nk-grid nk-grid--3">
    <article class="nk-card">
      <h3>Terminal</h3>
      <p>
        <code class="nk-inline">niki chat</code> — rich TUI with live agent state, sessions, checkpoints
        and undo. <code class="nk-inline">niki run --tui</code> for full-run streaming.
      </p>
    </article>
    <article class="nk-card">
      <h3>IDE via ACP</h3>
      <p>
        <code class="nk-inline">niki acp</code> runs an Agent Client Protocol server — drive the pipeline
        from Zed and other ACP-compatible editors.
      </p>
    </article>
    <article class="nk-card">
      <h3>CI / headless</h3>
      <p>
        <code class="nk-inline">niki run --bare --output-format json</code> — a stable envelope with pipe-pure
        stdout, fail-closed permissions and OTLP trace export (<code class="nk-inline"
          >--otel-endpoint</code
        >).
      </p>
    </article>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="observability-heading">
  <div class="nk-oss">
    <div>
      <p class="nk-eyebrow">Observability</p>
      <h2 id="observability-heading">Traces without a vendor.</h2>
      <p>
        Every run writes <code class="nk-inline">trace.jsonl</code> — an honestly derived span timeline,
        no instrumentation theater. Export spans over OTLP to any compatible backend, or keep everything
        local.
      </p>
    </div>
    <div class="nk-oss__actions">
      <a class="nk-btn nk-btn--secondary" href={docsUrl("/evals-auditing/audit-artifacts")}
        >Audit artifacts</a
      >
      <a class="nk-btn nk-btn--secondary" href={docsUrl(DOCS_ROUTES.cli)}>CLI reference</a>
    </div>
  </div>
</section>

<style>
  .nk-int-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--nk-space-3);
  }

  @media (min-width: 1024px) {
    .nk-int-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--nk-space-6);
      align-items: start;
    }
  }

  .nk-int-side h3 {
    margin-bottom: var(--nk-space-2);
  }

  .nk-provider-list {
    list-style: none;
    margin: var(--nk-space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  @media (min-width: 640px) {
    .nk-provider-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .nk-provider-list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .nk-provider-list li {
    font-family: var(--nk-font-mono);
    font-size: 0.75rem;
    padding: 6px 10px;
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-pill);
    text-align: center;
    color: var(--nk-text-secondary);
    background: var(--nk-bg-1);
  }

  .nk-split {
    display: grid;
    gap: var(--nk-space-4);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .nk-split {
      grid-template-columns: 1fr 1fr;
      gap: var(--nk-space-6);
    }
  }

  .nk-split h2 {
    margin-bottom: var(--nk-space-2);
  }

  .nk-split > div > p {
    margin-top: var(--nk-space-2);
  }

  .nk-oss {
    display: grid;
    gap: var(--nk-space-3);
  }

  @media (min-width: 900px) {
    .nk-oss {
      grid-template-columns: 1.6fr 1fr;
      align-items: center;
      gap: var(--nk-space-6);
    }
  }

  .nk-oss__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nk-space-1);
  }
</style>
