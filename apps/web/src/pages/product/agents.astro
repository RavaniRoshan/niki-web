---
import PageHeader from "../../components/PageHeader.astro";
import ProductSubNav from "../../components/ProductSubNav.astro";
import { DOCS_ROUTES, docsUrl } from "@niki/theme/site";

const agents = [
  {
    id: "planner",
    name: "Planner",
    glyph: "◈",
    color: "planner",
    one: "Reads the task and the current files, produces the TaskSpec.",
    artifact: "TaskSpec — which files to touch, and the approach",
    detail:
      "The Planner never writes code. It reads your task description plus existing file contents and emits a typed plan: scope, files, approach. With plan mode (`niki plan`), this is the only stage that runs — you review `plan.md` before anything executes.",
  },
  {
    id: "coder",
    name: "Coder",
    glyph: "⟠",
    color: "coder",
    one: "Emits a unified diff, applied to the sandboxed workspace.",
    artifact: "unified diff, applied inside the sandbox",
    detail:
      "The Coder works from the TaskSpec alone — it never sees the Planner's conversation. It emits a unified diff that Niki applies to the bind-mounted copy of your repo inside the container. Parallel coder topologies and a Synthesizer agent are available in `[pipeline]` config.",
  },
  {
    id: "tester",
    name: "Tester",
    glyph: "◉",
    color: "tester",
    one: "Generates and runs tests against the change.",
    artifact: "test results, with oracle provenance per case",
    detail:
      "The Tester generates and executes real test suites against the change. Every test case carries an `oracle_source` — spec, derived or property — and failing red suites block the branch unless you explicitly `--force` (recorded as NOT verified).",
  },
  {
    id: "reviewer",
    name: "Reviewer",
    glyph: "◆",
    color: "reviewer",
    one: "Issues the verdict; bounces work back until approved.",
    artifact: "verdict — correctness, quality, coverage scores",
    detail:
      "The Reviewer audits the prior stage's artifact, not shared state. On request-changes it loops back to the Coder for up to `max_revision_rounds`. Optional opt-in agents extend the loop: an adversarial Red agent probing the diff, and a Security Auditor pass.",
  },
];
---

<PageHeader
  eyebrow="Product · Pipeline"
  title="Planner → Coder → Tester → Reviewer."
  description="Four independent agents, each with its own prompt, model and context. They exchange typed artifacts — never a shared conversation. Independence is what removes the bias a single agent can't escape."
  canonicalPath="/product/agents"
>
  <div class="nk-pagehead__actions" slot="actions">
    <a class="nk-btn nk-btn--primary" href={docsUrl(DOCS_ROUTES.pipeline)}>Pipeline docs</a>
  </div>
</PageHeader>

<ProductSubNav />

<section class="nk-section nk-container" aria-labelledby="isolation-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">Architecture</p>
    <h2 id="isolation-heading">Isolated at two layers.</h2>
    <p>
      Filesystem isolation: each agent runs against a sandboxed copy of the repo. Context isolation:
      agents share no history — they exchange only typed artifacts, validated against JSON schemas.
    </p>
  </div>
  <div class="nk-agentflow">
    {
      agents.map((agent, i) => (
        <article class="nk-agentflow__agent" data-agent={agent.id}>
          <header>
            <span class="nk-agentflow__glyph" aria-hidden="true">
              {agent.glyph}
            </span>
            <span class="nk-agentflow__name">{agent.name}</span>
            <span class="nk-agentflow__step nk-mono">stage {i + 1}</span>
          </header>
          <p class="nk-agentflow__one">{agent.one}</p>
          <p class="nk-agentflow__detail">{agent.detail}</p>
          <span class="nk-agentflow__artifact">
            <span class="nk-mono">→ emits</span> {agent.artifact}
          </span>
          {i < agents.length - 1 && (
            <span class="nk-agentflow__conn" aria-hidden="true">
              ↓
            </span>
          )}
        </article>
      ))
    }
    <div class="nk-agentflow__out">
      <span class="nk-agentflow__out-badge">✓ verified branch</span>
      <span class="nk-mono nk-agentflow__out-branch">niki/&lt;id&gt;</span>
      <span class="nk-agentflow__out-note">
        Every emitted artifact is JSON-schema validated before the next stage consumes it.
      </span>
    </div>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="why-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">Why it matters</p>
    <h2 id="why-heading">vs. one agent in one conversation.</h2>
    <p>The failures of single-agent tools map exactly to what independence fixes:</p>
  </div>
  <div class="nk-vs">
    <div class="nk-vs__col">
      <h3 class="nk-vs__title nk-vs__title--bad">Single-agent loop</h3>
      <ul>
        <li>Confirmation bias — it never truly challenges its own assumptions</li>
        <li>Context drift — quality degrades as the conversation grows</li>
        <li>Babysitting tax — you steer, correct and re-verify constantly</li>
      </ul>
    </div>
    <div class="nk-vs__col nk-vs__col--good">
      <h3 class="nk-vs__title">Niki's pipeline</h3>
      <ul>
        <li>A Tester and Reviewer who never saw the Coder's reasoning</li>
        <li>Narrow contexts — each agent starts clean, no drift</li>
        <li>A Reviewer that bounces work back so you review a finished result</li>
      </ul>
    </div>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="specialized-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">Optional stages</p>
    <h2 id="specialized-heading">Specialized agents, opt-in.</h2>
    <p>Configurable, off by default, wired through the same artifact discipline:</p>
  </div>
  <div class="nk-grid nk-grid--3">
    <article class="nk-card">
      <h3>Red agent</h3>
      <p>
        An adversarial reviewer that probes the diff <em>before</em> the Reviewer. Opt-in via
        <code class="nk-inline">[red_blue] enabled = true</code>; sees evidence-only projections.
      </p>
    </article>
    <article class="nk-card">
      <h3>Security Auditor</h3>
      <p>
        A dedicated security pass over the change via
        <code class="nk-inline">[security]</code> — sees Planner and Coder artifacts only.
      </p>
    </article>
    <article class="nk-card">
      <h3>Parallel Coders</h3>
      <p>
        Run multiple Coder implementations in parallel with a Synthesizer agent that merges them —
        via <code class="nk-inline">[parallel]</code>.
      </p>
    </article>
  </div>
</section>

<style>
  .nk-agentflow {
    display: grid;
    gap: 0;
    max-width: 720px;
    margin-inline: auto;
  }

  .nk-agentflow__agent {
    position: relative;
    background: var(--nk-bg-1);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    padding: var(--nk-space-3);
    display: grid;
    gap: var(--nk-space-1);
    margin-bottom: 44px;
  }

  .nk-agentflow__agent:last-of-type {
    margin-bottom: 44px;
  }

  .nk-agentflow__agent header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nk-agentflow__glyph {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--nk-surface-border);
    border-radius: 8px;
    background: var(--nk-bg-2);
    font-size: 1.05rem;
  }

  [data-agent="planner"] .nk-agentflow__glyph {
    color: var(--nk-agent-planner);
  }
  [data-agent="coder"] .nk-agentflow__glyph {
    color: var(--nk-agent-coder);
  }
  [data-agent="tester"] .nk-agentflow__glyph {
    color: var(--nk-agent-tester);
  }
  [data-agent="reviewer"] .nk-agentflow__glyph {
    color: var(--nk-agent-reviewer);
  }

  .nk-agentflow__name {
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--nk-text-primary);
  }

  .nk-agentflow__step {
    margin-left: auto;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nk-text-muted);
  }

  .nk-agentflow__one {
    color: var(--nk-text-secondary);
    font-weight: 500;
  }

  .nk-agentflow__detail {
    font-size: 0.875rem;
    color: var(--nk-text-muted);
  }

  .nk-agentflow__artifact {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    font-size: 0.8125rem;
    color: var(--nk-text-secondary);
    border: 1px dashed var(--nk-surface-border);
    border-radius: var(--nk-radius-code);
    padding: 8px 12px;
    width: fit-content;
    background: var(--nk-bg-2);
  }

  .nk-agentflow__artifact .nk-mono {
    color: var(--nk-mint);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nk-agentflow__conn {
    position: absolute;
    bottom: -34px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--nk-mint);
    font-size: 1rem;
  }

  .nk-agentflow__out {
    border: 1px solid color-mix(in srgb, var(--nk-mint) 40%, var(--nk-surface-border));
    background: color-mix(in srgb, var(--nk-mint) 6%, var(--nk-bg-1));
    border-radius: var(--nk-radius-card);
    padding: var(--nk-space-3);
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .nk-agentflow__out-badge {
    color: var(--nk-mint);
    font-weight: 600;
  }

  .nk-agentflow__out-branch {
    color: var(--nk-text-primary);
    font-size: 0.875rem;
  }

  .nk-agentflow__out-note {
    font-size: 0.8125rem;
    color: var(--nk-text-muted);
  }

  /* vs table */
  .nk-vs {
    display: grid;
    gap: var(--nk-space-2);
  }

  @media (min-width: 900px) {
    .nk-vs {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nk-vs__col {
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    padding: var(--nk-space-3);
    background: var(--nk-bg-1);
  }

  .nk-vs__col--good {
    border-color: color-mix(in srgb, var(--nk-mint) 35%, var(--nk-surface-border));
  }

  .nk-vs__title {
    font-size: 1rem;
    margin-bottom: var(--nk-space-2);
  }

  .nk-vs__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .nk-vs__col li {
    color: var(--nk-text-secondary);
    font-size: 0.9375rem;
    display: flex;
    gap: 10px;
  }

  .nk-vs__col li::before {
    content: "–";
    color: var(--nk-text-muted);
  }

  .nk-vs__col--good li::before {
    content: "→";
    color: var(--nk-mint);
  }
</style>
