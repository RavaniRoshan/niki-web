---
import BaseLayout from "../layouts/BaseLayout.astro";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { SITE, WEB_ROUTES, DOCS_ROUTES, docsUrl } from "@niki/theme/site";
---

<BaseLayout
  title="Niki — One sentence in, a verified pull request out."
  description="Niki is the open-source multi-agent coding pipeline that plans, codes, tests, and reviews — then hands you a verified git branch. Four independent agents, hermetic sandboxes, full audit trail."
  canonicalPath="/"
>
  <!-- ============ Announcement ============ -->
  <div class="nk-announce nk-container">
    <a class="nk-badge nk-badge--mint" href={WEB_ROUTES.changelog}>
      <span class="nk-dot" aria-hidden="true"></span>
      v{SITE.release.version} shipped — plan mode, session control, headless CI contract
      <span class="nk-announce-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- ============ Hero ============ -->
  <section class="nk-hero nk-container nk-section nk-section--flush">
    <div class="nk-hero__grid">
      <div class="nk-hero__copy">
        <h1>One sentence in,<br />a verified pull request out.</h1>
        <p class="nk-hero__sub">
          Describe a task. Niki plans, codes, tests and reviews it across four independent agents —
          then hands you a reviewable branch with the full decision trail.
        </p>
        <div class="nk-hero__actions">
          <a class="nk-btn nk-btn--primary" href={docsUrl(DOCS_ROUTES.quickstart)}>Get Started</a>
          <a class="nk-btn nk-btn--secondary" href={docsUrl(DOCS_ROUTES.home)}>Read the Docs</a>
        </div>
        <ul class="nk-hero__facts">
          <li><span class="nk-mono">Apache-2.0</span> open source</li>
          <li><span class="nk-mono">Rust</span> single binary</li>
          <li><span class="nk-mono">BYOK</span> no telemetry</li>
        </ul>
      </div>

      <div class="nk-hero__demo">
        <TerminalWindow title="niki run">
          <span class="nk-t-line nk-t-brand"> ◈ ⟠ ◉ ◆&nbsp;&nbsp;NIKI</span>
          <span class="nk-t-line nk-t-m"
            >&nbsp;&nbsp;"Add a GET /health endpoint returning {"{ status: 'ok', uptime }"}"</span
          >
          <span class="nk-t-line">&nbsp;</span>
          <span class="nk-t-line"
            ><span class="nk-t-m">[Planner]&nbsp;&nbsp;&nbsp;</span>Done — Spec: 1 file to modify</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">[Coder]&nbsp;&nbsp;&nbsp;&nbsp;</span>Done — Changed 1 file ·
            index.js [modified]</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">[Tester]&nbsp;&nbsp;&nbsp;&nbsp;</span>Done — <span
              class="nk-t-ok">8/8 tests passed</span
            ></span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">[Reviewer]&nbsp;&nbsp;</span>Done — Approved · correctness 10/10 ·
            quality 8/10</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">[NIKI]&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>Task complete — <span
              class="nk-t-ok">Branch: niki/6d281d6d</span
            > · Verdict: Approved</span
          >
        </TerminalWindow>
        <div class="nk-hero__demo-caption nk-mono">
          actual output · <code class="nk-inline">niki run "Add a /health endpoint"</code>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Signature pipeline ============ -->
  <section class="nk-section nk-container" aria-labelledby="pipeline-heading">
    <div class="nk-section-head">
      <p class="nk-eyebrow">The pipeline</p>
      <h2 id="pipeline-heading">Four agents. Zero shared context.</h2>
      <p>
        Work is split across independent agents that exchange only typed artifacts — never one long
        conversation. Independence is the point: no agent can bias another.
      </p>
    </div>
    <PipelineDiagram />
    <p class="nk-pipeline-cta">
      <a class="nk-link-arrow" href={WEB_ROUTES.agents}>See how each agent works</a>
    </p>
  </section>

  <!-- ============ Why Niki ============ -->
  <section class="nk-section nk-container" aria-labelledby="why-heading">
    <div class="nk-section-head">
      <p class="nk-eyebrow">Why Niki</p>
      <h2 id="why-heading">Stop babysitting your AI.</h2>
      <p>
        Single-agent tools run one long conversation: confirmation bias, context drift, and a
        babysitting tax. Niki removes the human from the loop the agents can run themselves —
        debate.
      </p>
    </div>
    <div class="nk-grid nk-grid--3">
      <article class="nk-card">
        <div class="nk-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
        </div>
        <h3>Multi-agent, not monolithic</h3>
        <p>
          Planning, coding, testing and review are separate agents with their own prompts and models
          — each does one job well.
        </p>
      </article>
      <article class="nk-card">
        <div class="nk-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 2 4 5.5v5.7c0 5 3.4 8.6 8 10.8 4.6-2.2 8-5.8 8-10.8V5.5L12 2Z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <h3>Hermetic by default</h3>
        <p>
          All work happens in a rootless Podman or Docker sandbox against a copy of your repo.
          Network egress blocked unless you allow it.
        </p>
      </article>
      <article class="nk-card">
        <div class="nk-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="6" cy="6" r="2.5"></circle>
            <circle cx="18" cy="6" r="2.5"></circle>
            <circle cx="6" cy="18" r="2.5"></circle>
            <circle cx="18" cy="18" r="2.5"></circle>
            <path d="M8.2 7.4 15.8 10.6M8.2 16.6l7.6-3.2M6 8.5v7M18 8.5v7"></path>
          </svg>
        </div>
        <h3>Output is a git branch</h3>
        <p>
          You get <code class="nk-inline">niki/&lt;id&gt;</code> with a real commit, a diff and artifacts
          — reviewable like any human PR. Nothing lands on main until you say so.
        </p>
      </article>
      <article class="nk-card">
        <div class="nk-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 7V4h3M20 7V4h-3M4 17v3h3M20 17v3h-3"></path>
            <path d="M9 10h6M9 14h4"></path>
          </svg>
        </div>
        <h3>Reviewer-driven revisions</h3>
        <p>
          The Reviewer bounces work back to the Coder until it's approved — up to
          <code class="nk-inline">max_revision_rounds</code>. You review a finished result.
        </p>
      </article>
      <article class="nk-card">
        <div class="nk-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
            <path d="M11 13c-4 0-7 2-7 5v3h14v-3c0-3-3-5-7-5Z"></path>
            <path d="m19 8 1 1-1 1-1-1 1-1ZM20 12h1M19 16h1"></path>
          </svg>
        </div>
        <h3>Fully auditable</h3>
        <p>
          <code class="nk-inline">report.md</code>, <code class="nk-inline">changes.patch</code>
          and per-agent JSON artifacts capture what every agent decided, and why.
        </p>
      </article>
      <article class="nk-card">
        <div class="nk-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 6h16M4 12h10M4 18h7"></path>
            <path d="m18 14 2 2-4 4-2 .5.5-2 3.5-4.5Z"></path>
          </svg>
        </div>
        <h3>BYOK & provider-mixing</h3>
        <p>
          Bring your own keys. Give each agent a different provider — a strong reasoner for Planner,
          a cheap model for Tester.
        </p>
      </article>
    </div>
  </section>

  <!-- ============ Verified output ============ -->
  <section class="nk-section nk-container" aria-labelledby="output-heading">
    <div class="nk-split">
      <div>
        <p class="nk-eyebrow">Verified output</p>
        <h2 id="output-heading">Proof, not promises.</h2>
        <p>
          Every run leaves behind the entire decision trail: a reviewable branch, a unified diff, a
          human-readable report and per-agent JSON artifacts. Failing test suites block the branch
          unless you explicitly override.
        </p>
        <ul class="nk-checklist">
          <li>
            Reviewable <code class="nk-inline">niki/&lt;id&gt;</code> branch with a real commit
          </li>
          <li>
            <code class="nk-inline">changes.patch</code> — the unified diff, inspectable anywhere
          </li>
          <li><code class="nk-inline">report.md</code> — human-readable run report with verdict</li>
          <li>
            <code class="nk-inline">artifacts/*.json</code> — what each agent decided, and why
          </li>
          <li><code class="nk-inline">niki audit</code> — consolidated compliance bundle</li>
        </ul>
        <p class="nk-after">
          <a class="nk-link-arrow" href={docsUrl(DOCS_ROUTES.evals)}
            >Read about the audit methodology</a
          >
        </p>
      </div>
      <figure class="nk-figure">
        <img
          src="/media/diff.png"
          alt="Niki dashboard showing the diff of a completed run, with changed files and the generated patch"
          width="1200"
          height="600"
          loading="lazy"
        />
        <figcaption class="nk-mono">niki dashboard — the diff of a finished run</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ Sandbox / security ============ -->
  <section class="nk-section nk-container" aria-labelledby="security-heading">
    <div class="nk-split nk-split--rev">
      <div>
        <p class="nk-eyebrow">Security & sandboxing</p>
        <h2 id="security-heading">Hermetic by default.</h2>
        <p>
          Agents work inside a rootless container with dropped capabilities and a read-only root
          filesystem. Egress is blocked unless you allow it. Your working tree is never touched
          mid-run.
        </p>
        <ul class="nk-checklist">
          <li>
            Rootless Podman or Docker, <code class="nk-inline">CapDrop ALL</code>, read-only rootfs
          </li>
          <li>Network egress blocked by default — allowlist to open it</li>
          <li>
            Command deny-lists: <code class="nk-inline">rm -rf /</code> and <code class="nk-inline"
              >curl | sh</code
            > blocked by policy
          </li>
          <li>Hard-enforced spend cap aborts before a branch is created</li>
          <li>Fail-closed permission modes for headless CI</li>
        </ul>
        <p class="nk-after">
          <a class="nk-link-arrow" href={WEB_ROUTES.security}>Explore the security model</a>
        </p>
      </div>
      <div class="nk-security-stack">
        <TerminalWindow title="niki doctor">
          <span class="nk-t-line nk-t-brand">$ niki doctor</span>
          <span class="nk-t-line"
            ><span class="nk-t-m">install&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="nk-t-ok"
              >ok</span
            >&nbsp;&nbsp;&nbsp;niki 0.7.0</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">config&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="nk-t-ok"
              >ok</span
            >&nbsp;&nbsp;&nbsp;niki.toml found</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">providers&nbsp;&nbsp;&nbsp;</span><span class="nk-t-ok">ok</span
            >&nbsp;&nbsp;&nbsp;anthropic, ollama</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">sandbox&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="nk-t-ok"
              >ok</span
            >&nbsp;&nbsp;&nbsp;podman · niki-sandbox:24.04</span
          >
          <span class="nk-t-line"
            ><span class="nk-t-m">security&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="nk-t-ok"
              >ok</span
            >&nbsp;&nbsp;&nbsp;egress blocked · capdrop all</span
          >
          <span class="nk-t-line"><span class="nk-t-ok">✓ ready to run</span></span>
        </TerminalWindow>
        <TerminalWindow title="niks sandbox policy" class="nk-term--policy">
          <span class="nk-t-line"><span class="nk-t-m">[sandbox]</span></span>
          <span class="nk-t-line">network_disabled = <span class="nk-t-mag">true</span></span>
          <span class="nk-t-line">cap_drop = <span class="nk-t-mag">"ALL"</span></span>
          <span class="nk-t-line">rootfs = <span class="nk-t-mag">"read-only"</span></span>
          <span class="nk-t-line"
            >deny = [<span class="nk-t-mag">"rm -rf /"</span>, <span class="nk-t-mag"
              >"curl | sh"</span
            >]</span
          >
        </TerminalWindow>
      </div>
    </div>
  </section>

  <!-- ============ Demo ============ -->
  <section class="nk-section nk-container" aria-labelledby="demo-heading">
    <div class="nk-section-head">
      <p class="nk-eyebrow">Watch it run</p>
      <h2 id="demo-heading">A full run, end to end.</h2>
      <p>Real recording of Niki executing a task through all four agents.</p>
    </div>
    <figure class="nk-figure nk-figure--wide">
      <video
        controls
        preload="metadata"
        poster="/media/diff.png"
        aria-label="Screen recording of a Niki run: a task described in one sentence flows through the Planner, Coder, Tester and Reviewer agents and finishes as a verified branch"
      >
        <source src="/media/niki-run-demo.mp4" type="video/mp4" />
        Your browser does not support embedded video. Download the
        <a href="/media/niki-run-demo.mp4">demo recording</a> instead.
      </video>
      <figcaption class="nk-mono">niki 0.7.0 · four-agent pipeline · ~90s task</figcaption>
    </figure>
  </section>

  <!-- ============ Providers / BYOK ============ -->
  <section class="nk-section nk-container" aria-labelledby="providers-heading">
    <div class="nk-split">
      <div>
        <p class="nk-eyebrow">BYOK · providers</p>
        <h2 id="providers-heading">Your keys. Any model. Per agent.</h2>
        <p>
          Niki ships no proxy and phones home to no one. Point each agent at the provider that fits
          its job — or run everything on a local Ollama for $0.00.
        </p>
        <p class="nk-after">
          <a class="nk-link-arrow" href={WEB_ROUTES.integrations}>See all integrations</a>
        </p>
      </div>
      <div class="nk-providers">
        <CodeBlock
          label="niki.toml — per-agent models"
          lang="toml"
          code={`[agents.planner]
provider = "anthropic"
model    = "claude-sonnet-4"

[agents.coder]
provider = "anthropic"
model    = "claude-sonnet-4"

[agents.tester]
provider = "openai"
model    = "gpt-4o-mini"   # cheap, test-gen is easy

[agents.reviewer]
provider = "anthropic"
model    = "claude-sonnet-4"`}
        />
        <ul class="nk-provider-list">
          <li>Anthropic</li>
          <li>OpenAI</li>
          <li>Google</li>
          <li>Ollama</li>
          <li>OpenRouter</li>
          <li>OpenCode Zen</li>
          <li>Kimi Code</li>
          <li>KiloCode</li>
          <li>NVIDIA</li>
          <li>Groq</li>
          <li>Together</li>
          <li>DeepSeek</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ TUI / developer workflow ============ -->
  <section class="nk-section nk-container" aria-labelledby="tui-heading">
    <div class="nk-section-head">
      <p class="nk-eyebrow">Developer workflow</p>
      <h2 id="tui-heading">Terminal-native. IDE-ready.</h2>
      <p>
        A rich TUI for interactive runs and a headless JSON contract for CI. The same pipeline,
        wherever you work.
      </p>
    </div>
    <div class="nk-grid nk-grid--3">
      <article class="nk-card">
        <h3>Interactive TUI</h3>
        <p>
          <code class="nk-inline">niki chat</code> streams agent state live — a unified status grammar,
          no flicker, reduced-motion aware.
        </p>
      </article>
      <article class="nk-card">
        <h3>Headless CI</h3>
        <p>
          <code class="nk-inline">niki run --bare --output-format json</code> gives a stable, pipe-pure
          JSON envelope. OTLP trace export included.
        </p>
      </article>
      <article class="nk-card">
        <h3>ACP / IDE</h3>
        <p>
          <code class="nk-inline">niki acp</code> speaks the Agent Client Protocol — drive Niki from Zed
          and other ACP-compatible editors.
        </p>
      </article>
    </div>
  </section>

  <!-- ============ Open source ============ -->
  <section class="nk-section nk-container" aria-labelledby="oss-heading">
    <div class="nk-oss">
      <div>
        <p class="nk-eyebrow">Open source</p>
        <h2 id="oss-heading">Free software, honest claims.</h2>
        <p>
          Apache-2.0, built in Rust, one binary. Every marketing claim is mapped to the code that
          backs it — and corrected when it doesn't. No telemetry, no hosted middleman, no training
          on your code.
        </p>
      </div>
      <div class="nk-oss__actions">
        <a class="nk-btn nk-btn--primary" href={SITE.repo} rel="noopener noreferrer"
          >Star on GitHub</a
        >
        <a class="nk-btn nk-btn--secondary" href={WEB_ROUTES.downloads}>Download</a>
        <a class="nk-btn nk-btn--secondary" href={SITE.social.issues} rel="noopener noreferrer"
          >Issue Tracker</a
        >
      </div>
    </div>
  </section>

  <!-- ============ Pricing teaser ============ -->
  <section class="nk-section nk-container" aria-labelledby="pricing-heading">
    <div class="nk-pricing-teaser">
      <div>
        <p class="nk-eyebrow">Pricing</p>
        <h2 id="pricing-heading">$0. Pay your provider, not us.</h2>
        <p>
          Niki is free open-source software. You bring your own keys — a real task costs about a
          cent on a frontier model, or nothing on local Ollama. Spend caps keep it bounded.
        </p>
      </div>
      <a class="nk-btn nk-btn--secondary" href={WEB_ROUTES.pricing}>See pricing details</a>
    </div>
  </section>

  <!-- ============ Final CTA ============ -->
  <section class="nk-section nk-container nk-cta-final" aria-labelledby="cta-heading">
    <h2 id="cta-heading">Delegate the task. Review the branch.</h2>
    <p>First verified branch in under five minutes — no container runtime required to start.</p>
    <div class="nk-cta-final__actions">
      <a class="nk-btn nk-btn--primary" href={docsUrl(DOCS_ROUTES.quickstart)}>Get Started</a>
      <a class="nk-btn nk-btn--secondary" href={docsUrl(DOCS_ROUTES.home)}>Read the Docs</a>
    </div>
    <CodeBlock
      label="or, zero-setup first run (worktree backend + local Ollama)"
      code={`curl -fsSL https://raw.githubusercontent.com/RavaniRoshan/niki/master/scripts/install.sh | bash
niki init --interactive
niki run "Add a /health endpoint" --backend worktree`}
    />
  </section>
</BaseLayout>

<style>
  /* announce */
  .nk-announce {
    padding-top: var(--nk-space-2);
  }
  .nk-announce a {
    transition: border-color 0.15s ease;
  }
  .nk-announce a:hover {
    text-decoration: none;
    border-color: var(--nk-mint);
  }
  .nk-announce-arrow {
    color: var(--nk-mint);
  }

  /* hero */
  .nk-hero__grid {
    display: grid;
    gap: var(--nk-space-4);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .nk-hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--nk-space-6);
    }
  }

  .nk-hero__sub {
    margin-top: var(--nk-space-3);
    font-size: 1.125rem;
    max-width: 34rem;
    color: var(--nk-text-secondary);
  }

  .nk-hero__actions {
    margin-top: var(--nk-space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--nk-space-1);
  }

  .nk-hero__facts {
    list-style: none;
    margin: var(--nk-space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px var(--nk-space-2);
    font-size: 0.875rem;
    color: var(--nk-text-muted);
    max-width: 100%;
  }

  .nk-hero__facts li {
    white-space: normal;
  }

  .nk-hero__facts .nk-mono {
    color: var(--nk-mint);
  }

  .nk-hero__demo-caption {
    margin-top: 10px;
    font-size: 0.75rem;
    color: var(--nk-text-muted);
    text-align: center;
  }

  /* pipeline cta */
  .nk-pipeline-cta {
    margin-top: var(--nk-space-4);
    text-align: center;
  }

  /* splits */
  .nk-split {
    display: grid;
    gap: var(--nk-space-4);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .nk-split {
      grid-template-columns: 1fr 1fr;
      gap: var(--nk-space-6);
    }
    .nk-split--rev > :first-child {
      order: 2;
    }
  }

  .nk-split p {
    margin-top: var(--nk-space-2);
  }

  .nk-after {
    margin-top: var(--nk-space-3) !important;
  }

  /* figures */
  .nk-figure {
    margin: 0;
    display: grid;
    gap: 10px;
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    padding: var(--nk-space-1);
    background: var(--nk-bg-1);
    overflow: hidden;
  }

  .nk-figure img,
  .nk-figure video {
    width: 100%;
    height: auto;
    border-radius: calc(var(--nk-radius-card) - 6px);
  }

  .nk-figure figcaption {
    font-size: 0.75rem;
    color: var(--nk-text-muted);
    padding: 0 8px 8px;
  }

  .nk-figure--wide {
    max-width: 900px;
    margin-inline: auto;
  }

  /* security stack */
  .nk-security-stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--nk-space-2);
  }

  /* providers */
  .nk-providers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--nk-space-2);
  }

  .nk-provider-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  @media (min-width: 640px) {
    .nk-provider-list {
