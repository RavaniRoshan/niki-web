---
import PageHeader from "../components/PageHeader.astro";
import { WEB_ROUTES, DOCS_ROUTES, docsUrl } from "@niki/theme/site";

/**
 * Pricing — reflects the CURRENT reality: Niki is free open-source software.
 * The plan cards below describe future boundaries honestly (marked "future"),
 * and the page architecture (this data object) is what future billing
 * functionality will attach to. No payment functionality exists today.
 */
---

<PageHeader
  eyebrow="Pricing"
  title="Free software. Bring your own keys."
  description="Niki is open source under Apache-2.0. There is no paid tier today and no payment functionality exists. You pay your model provider — or nothing at all on local Ollama."
  canonicalPath="/pricing"
>
  <div class="nk-pagehead__actions" slot="actions">
    <a class="nk-btn nk-btn--primary" href={WEB_ROUTES.downloads}>Download Niki</a>
    <a class="nk-btn nk-btn--secondary" href={docsUrl(DOCS_ROUTES.providers)}>Provider setup</a>
  </div>
</PageHeader>

<section class="nk-section nk-container">
  <div class="nk-pr-today">
    <div>
      <p class="nk-eyebrow">Today</p>
      <h2>$0 — the whole pipeline.</h2>
      <p>
        Every capability on this site ships in the open-source release: all four agents, sandboxing,
        plan mode, evals, the TUI, ACP — everything. There is no feature-gated tier, no seat
        license, no hosted requirement.
      </p>
    </div>
    <ul class="nk-pr-checklist">
      <li>All four pipeline agents + optional Red / Security / Parallel stages</li>
      <li>Podman, Docker and worktree sandbox backends</li>
      <li>All 12 providers + gateway support, per-agent model mixing</li>
      <li>Plan mode, sessions, memory, goals, research commands</li>
      <li>Evals harness, audit bundles, OTLP trace export</li>
      <li>Apache-2.0 — use it commercially, modify it, ship it</li>
    </ul>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="cost-heading">
  <div class="nk-split">
    <div>
      <p class="nk-eyebrow">What a run actually costs</p>
      <h2 id="cost-heading">You pay tokens, not seats.</h2>
      <p>
        A real small task measured ~2.9k input / ~0.25k output tokens across the whole pipeline. At
        provider list rates that's about a cent on a frontier model — and
        <strong>$0.00 on a local Ollama</strong>. Niki meters every run honestly and enforces your <code
          class="nk-inline">spend_cap_usd</code
        > hard, before a branch is created.
      </p>
      <p class="nk-after">
        <a class="nk-link-arrow" href={docsUrl("/evals-auditing/benchmarks-and-evals")}
          >See cost benchmarks</a
        >
      </p>
    </div>
    <div class="nk-pr-costs" role="table" aria-label="Typical cost per small task by provider">
      <div class="nk-pr-costs__head" role="row">
        <span role="columnheader">Setup</span>
        <span role="columnheader">Typical task</span>
      </div>
      <div class="nk-pr-costs__row" role="row">
        <span role="cell">Local Ollama</span>
        <span role="cell" class="nk-pr-mint">$0.00</span>
      </div>
      <div class="nk-pr-costs__row" role="row">
        <span role="cell">Claude Sonnet 4</span>
        <span role="cell">~$0.01</span>
      </div>
      <div class="nk-pr-costs__row" role="row">
        <span role="cell">Haiku / GPT-4o-mini</span>
        <span role="cell">&lt; $0.005</span>
      </div>
      <p class="nk-pr-costs__note">
        Measured on a real task at provider list rates; your tasks and models vary. Every run
        reports its exact tokens and cost.
      </p>
    </div>
  </div>
</section>

<section class="nk-section nk-container" aria-labelledby="future-heading">
  <div class="nk-section-head">
    <p class="nk-eyebrow">The future, honestly labeled</p>
    <h2 id="future-heading">Boundaries we may build — none exist yet.</h2>
    <p>
      Cloud execution and enterprise features are on the public roadmap. When paid plans ship, they
      will cover infrastructure we run for you — the local pipeline stays free forever. No payment,
      account or billing functionality exists today.
    </p>
  </div>

  <div class="nk-pr-grid">
    <article class="nk-pr-plan nk-pr-plan--current" aria-labelledby="plan-oss">
      <span class="nk-pr-plan__badge nk-badge nk-badge--mint">current</span>
      <h3 id="plan-oss">Open Source</h3>
      <p class="nk-pr-plan__price">$0<span> / forever</span></p>
      <p class="nk-pr-plan__desc">
        The complete pipeline, self-hosted. You run it, you own the keys, you keep the artifacts.
      </p>
      <ul class="nk-pr-plan__list">
        <li>Everything in the current release</li>
        <li>Community support via GitHub</li>
        <li>Your infrastructure, your providers</li>
      </ul>
      <a class="nk-btn nk-btn--primary" href={WEB_ROUTES.downloads}>Download</a>
    </article>

    <article class="nk-pr-plan nk-pr-plan--future" aria-labelledby="plan-cloud">
      <span class="nk-pr-plan__badge nk-badge">future</span>
      <h3 id="plan-cloud">Cloud Execution <span class="nk-pr-plan__beta">beta, planned</span></h3>
      <p class="nk-pr-plan__price">TBD</p>
      <p class="nk-pr-plan__desc">
        Sandboxed runs on managed infrastructure — for when you want the pipeline without the host
        setup.
      </p>
      <ul class="nk-pr-plan__list">
        <li>Managed sandboxes, zero local setup</li>
        <li>Same artifacts, same audit trail</li>
        <li>Pricing announced with the beta</li>
      </ul>
      <span class="nk-pr-plan__notify nk-muted">Watch the changelog for availability</span>
    </article>

    <article class="nk-pr-plan nk-pr-plan--future" aria-labelledby="plan-enterprise">
      <span class="nk-pr-plan__badge nk-badge">future</span>
      <h3 id="plan-enterprise">Enterprise</h3>
      <p class="nk-pr-plan__price">TBD</p>
      <p class="nk-pr-plan__desc">
        Organizational controls around the same pipeline: SSO, policy, and deployment options.
      </p>
      <ul class="nk-pr-plan__list">
        <li>Org-level permissions and policy</li>
        <li>Deployment and compliance support</li>
        <li>Architect agent and advanced evals</li>
      </ul>
      <span class="nk-pr-plan__notify nk-muted">Not yet available</span>
    </article>
  </div>

  <p class="nk-pr-footnote">
    Note: these future plans describe roadmap intent only — no subscriptions, checkout, accounts or
    usage metering of ours exist today. When they do, this page is where they'll live.
  </p>
</section>

<style>
  .nk-pr-today {
    display: grid;
    gap: var(--nk-space-4);
    padding: var(--nk-space-4);
    border: 1px solid color-mix(in srgb, var(--nk-mint) 35%, var(--nk-surface-border));
    border-radius: var(--nk-radius-card);
    background: color-mix(in srgb, var(--nk-mint) 4%, var(--nk-bg-1));
    align-items: start;
  }

  @media (min-width: 1024px) {
    .nk-pr-today {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--nk-space-6);
      padding: var(--nk-space-5);
    }
  }

  .nk-pr-today h2 {
    margin-bottom: var(--nk-space-2);
  }

  .nk-pr-today p {
    margin-top: var(--nk-space-2);
    color: var(--nk-text-secondary);
  }

  .nk-pr-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.9375rem;
  }

  .nk-pr-checklist li {
    display: flex;
    gap: 10px;
    color: var(--nk-text-secondary);
  }

  .nk-pr-checklist li::before {
    content: "✓";
    color: var(--nk-mint);
    font-family: var(--nk-font-mono);
    flex: none;
  }

  .nk-split {
    display: grid;
    gap: var(--nk-space-4);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .nk-split {
      grid-template-columns: 1fr 1fr;
      gap: var(--nk-space-6);
    }
  }

  .nk-split h2 {
    margin-bottom: var(--nk-space-2);
  }

  .nk-split > div > p {
    margin-top: var(--nk-space-2);
  }

  .nk-pr-costs {
    display: grid;
    gap: 0;
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    background: var(--nk-bg-1);
    overflow: hidden;
  }

  .nk-pr-costs__head,
  .nk-pr-costs__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    padding: 12px 16px;
  }

  .nk-pr-costs__head {
    background: var(--nk-bg-2);
    font-family: var(--nk-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--nk-text-muted);
  }

  .nk-pr-costs__row {
    border-top: 1px solid var(--nk-surface-border);
    font-size: 0.9375rem;
    color: var(--nk-text-secondary);
  }

  .nk-pr-mint {
    color: var(--nk-mint);
    font-family: var(--nk-font-mono);
  }

  .nk-pr-costs__note {
    grid-column: 1 / -1;
    padding: 12px 16px;
    font-size: 0.8125rem;
    color: var(--nk-text-muted);
    border-top: 1px solid var(--nk-surface-border);
    margin: 0;
  }

  .nk-pr-grid {
    display: grid;
    gap: var(--nk-space-2);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .nk-pr-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .nk-pr-plan {
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    padding: var(--nk-space-3);
    background: var(--nk-bg-1);
    display: grid;
    gap: var(--nk-space-1);
    align-content: start;
  }

  .nk-pr-plan--current {
    border-color: color-mix(in srgb, var(--nk-mint) 40%, var(--nk-surface-border));
    background: color-mix(in srgb, var(--nk-mint) 5%, var(--nk-bg-1));
  }

  .nk-pr-plan--future {
    opacity: 0.92;
  }

  .nk-pr-plan__badge {
    margin-bottom: 4px;
  }

  .nk-pr-plan__price {
    font-size: 2rem;
    font-weight: 650;
    color: var(--nk-text-primary);
    margin-top: 8px;
  }

  .nk-pr-plan__price span {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--nk-text-muted);
  }

  .nk-pr-plan__beta {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--nk-magenta);
    font-family: var(--nk-font-mono);
  }

  .nk-pr-plan__desc {
    font-size: 0.9375rem;
    color: var(--nk-text-secondary);
  }

  .nk-pr-plan__list {
    list-style: none;
    margin: var(--nk-space-1) 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--nk-text-muted);
  }

  .nk-pr-plan__list li {
    display: flex;
    gap: 8px;
  }

  .nk-pr-plan--current .nk-pr-plan__list li::before {
    content: "✓";
    color: var(--nk-mint);
    flex: none;
  }

  .nk-pr-plan--future .nk-pr-plan__list li::before {
    content: "·";
    color: var(--nk-text-muted);
    flex: none;
  }

  .nk-pr-plan .nk-btn {
    margin-top: var(--nk-space-1);
    width: fit-content;
  }

  .nk-pr-plan__notify {
    font-size: 0.8125rem;
    margin-top: var(--nk-space-1);
  }

  .nk-pr-footnote {
    margin-top: var(--nk-space-3);
    font-size: 0.8125rem;
    color: var(--nk-text-muted);
    max-width: 60rem;
  }
</style>
