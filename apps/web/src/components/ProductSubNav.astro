---
import { WEB_ROUTES } from "@niki/theme/site";

/**
 * SubNav — product section tab navigation (sticky under header).
 */
const items = [
  { label: "Overview", href: WEB_ROUTES.product },
  { label: "Multi-Agent Pipeline", href: WEB_ROUTES.agents },
  { label: "Security & Sandboxing", href: WEB_ROUTES.security },
  { label: "Integrations", href: WEB_ROUTES.integrations },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="nk-subnav" aria-label="Product">
  <div class="nk-container nk-subnav__inner">
    {
      items.map((item) => (
        <a
          href={item.href}
          class:list={["nk-subnav__link", currentPath === item.href && "is-active"]}
          aria-current={currentPath === item.href ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .nk-subnav {
    position: sticky;
    top: var(--nk-header-h);
    z-index: 90;
    background: color-mix(in srgb, var(--nk-bg-0) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--nk-surface-border);
  }

  .nk-subnav__inner {
    display: flex;
    gap: var(--nk-space-1);
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 10px;
  }

  .nk-subnav__inner::-webkit-scrollbar {
    display: none;
  }

  .nk-subnav__link {
    padding: 7px 14px;
    border-radius: var(--nk-radius-pill);
    color: var(--nk-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .nk-subnav__link:hover {
    color: var(--nk-text-primary);
    text-decoration: none;
  }

  .nk-subnav__link.is-active {
    color: var(--nk-mint);
    border-color: color-mix(in srgb, var(--nk-mint) 30%, transparent);
    background: color-mix(in srgb, var(--nk-mint) 7%, transparent);
  }
</style>
