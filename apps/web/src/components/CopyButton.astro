---
/**
 * CopyButton — accessible copy-to-clipboard island. Minimal JS, progressive.
 */
interface Props {
  text: string;
  label?: string;
  class?: string;
}
const { text, label = "Copy", class: cls } = Astro.props;
const encoded = encodeURIComponent(text);
---

<button
  class:list={["nk-copy", cls]}
  type="button"
  data-copy={encoded}
  aria-label={label}
  title={label}
>
  <svg class="nk-copy__icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M4.5 4.5V3a1 1 0 0 1 1-1H13a1 1 0 0 1 1 1v7.5a1 1 0 0 1-1 1h-1.5M3 5.5h7.5a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="nk-copy__check" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M2.5 8.5 6 12 13.5 4.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
    const done = () => {
      btn.classList.add("nk-copy--done");
      btn.setAttribute("aria-label", "Copied");
      setTimeout(() => {
        btn.classList.remove("nk-copy--done");
        btn.setAttribute("aria-label", "Copy");
      }, 1600);
    };
    btn.addEventListener("click", () => {
      const text = decodeURIComponent(btn.dataset.copy ?? "");
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        done();
      }
    });
  });
</script>

<style>
  .nk-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--nk-surface-border);
    background: var(--nk-bg-2);
    color: var(--nk-text-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
    flex: none;
  }

  .nk-copy:hover {
    color: var(--nk-mint);
    border-color: var(--nk-mint);
  }

  .nk-copy__check {
    display: none;
    color: var(--nk-mint);
  }

  .nk-copy--done .nk-copy__icon {
    display: none;
  }
  .nk-copy--done .nk-copy__check {
    display: block;
  }
</style>
