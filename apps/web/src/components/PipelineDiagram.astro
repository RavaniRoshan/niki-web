---
/**
 * PipelineDiagram — Niki's signature visual motif.
 * Task → Planner → Coder → Tester → Reviewer → Verified branch.
 * Static-rendered states; CSS animation adds a subtle traveling pulse along
 * the connectors (gated by prefers-reduced-motion via global.css).
 */

const agents = [
  {
    id: "planner",
    name: "Planner",
    glyph: "◈",
    state: "complete",
    stateLabel: "done",
    desc: "Reads the task, maps scope, writes the TaskSpec",
    detail: "1 file to modify",
  },
  {
    id: "coder",
    name: "Coder",
    glyph: "⟠",
    state: "complete",
    stateLabel: "done",
    desc: "Emits a unified diff, applied inside the sandbox",
    detail: "index.js modified",
  },
  {
    id: "tester",
    name: "Tester",
    glyph: "◉",
    state: "complete",
    stateLabel: "done",
    desc: "Generates and runs tests against the change",
    detail: "8/8 tests passed",
  },
  {
    id: "reviewer",
    name: "Reviewer",
    glyph: "◆",
    state: "reviewing",
    stateLabel: "verdict",
    desc: "Audits quality, requests revisions or approves",
    detail: "correctness 10/10",
  },
];

const stateText: Record<string, string> = {
  complete: "done",
  reviewing: "approved",
  running: "running",
  queued: "queued",
  failed: "failed",
};
---

<div
  class="nk-pipeline"
  role="img"
  aria-label="Niki pipeline: a task flows through the Planner, Coder, Tester and Reviewer agents, then lands as a verified git branch"
>
  <div class="nk-pipeline__track">
    <div class="nk-pipeline__start">
      <span class="nk-pipeline__start-label">task</span>
      <span class="nk-pipeline__start-text">"Add a /health endpoint"</span>
    </div>

    {
      agents.map((agent) => (
        <>
          <div class="nk-pipeline__conn" aria-hidden="true">
            <span class="nk-pipeline__conn-line" />
          </div>
          <article class="nk-pipeline__agent" data-agent={agent.id} data-state={agent.state}>
            <header class="nk-pipeline__agent-head">
              <span class="nk-pipeline__glyph" aria-hidden="true">
                {agent.glyph}
              </span>
              <span class="nk-pipeline__agent-name">{agent.name}</span>
              <span class={`nk-pipeline__state nk-pipeline__state--${agent.state}`}>
                <span class="nk-dot" aria-hidden="true" />
                {stateText[agent.state]}
              </span>
            </header>
            <p class="nk-pipeline__agent-desc">{agent.desc}</p>
            <span class="nk-pipeline__agent-detail nk-mono">{agent.detail}</span>
          </article>
        </>
      ))
    }

    <div class="nk-pipeline__conn nk-pipeline__conn--final" aria-hidden="true">
      <span class="nk-pipeline__conn-line"></span>
    </div>
    <div class="nk-pipeline__end" data-state="verified">
      <span class="nk-pipeline__end-badge">✓ verified branch</span>
      <span class="nk-pipeline__end-branch nk-mono">niki/6d281d6d</span>
      <span class="nk-pipeline__end-artifacts nk-mono"
        >changes.patch · report.md · artifacts/*.json</span
      >
    </div>
  </div>

  <p class="nk-pipeline__hint nk-mono">
    agents exchange typed artifacts — never a shared conversation
  </p>
</div>

<style>
  .nk-pipeline {
    display: grid;
    gap: var(--nk-space-3);
    justify-items: center;
  }

  .nk-pipeline__track {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 560px;
    gap: 0;
  }

  /* ---- task start ---- */
  .nk-pipeline__start {
    background: var(--nk-bg-2);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-pill);
    padding: 10px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--nk-font-mono);
    font-size: 0.8125rem;
    max-width: 100%;
    overflow: hidden;
  }

  .nk-pipeline__start-label {
    color: var(--nk-mint);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: none;
  }

  .nk-pipeline__start-text {
    color: var(--nk-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- connectors ---- */
  .nk-pipeline__conn {
    display: grid;
    place-items: center;
    padding: 6px 0;
    position: relative;
  }

  .nk-pipeline__conn-line {
    width: 1px;
    height: 20px;
    background: linear-gradient(
      to bottom,
      var(--nk-surface-border),
      color-mix(in srgb, var(--nk-mint) 55%, var(--nk-surface-border))
    );
    position: relative;
    overflow: hidden;
  }

  /* subtle traveling pulse along connectors */
  .nk-pipeline__conn-line::after {
    content: "";
    position: absolute;
    left: -1.5px;
    top: -8px;
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--nk-mint);
    animation: nk-conn-flow 2.4s linear infinite;
    animation-delay: var(--conn-delay, 0s);
    opacity: 0.9;
  }

  .nk-pipeline__conn:nth-of-type(1) .nk-pipeline__conn-line::after {
    animation-delay: 0s;
  }
  .nk-pipeline__conn:nth-of-type(3) .nk-pipeline__conn-line::after {
    animation-delay: 0.6s;
  }
  .nk-pipeline__conn:nth-of-type(5) .nk-pipeline__conn-line::after {
    animation-delay: 1.2s;
  }
  .nk-pipeline__conn:nth-of-type(7) .nk-pipeline__conn-line::after {
    animation-delay: 1.8s;
  }
  .nk-pipeline__conn--final .nk-pipeline__conn-line::after {
    animation-delay: 2.2s;
    background: var(--nk-mint);
  }

  @keyframes nk-conn-flow {
    from {
      top: -8px;
    }
    to {
      top: 20px;
    }
  }

  /* ---- agent cards ---- */
  .nk-pipeline__agent {
    background: var(--nk-bg-1);
    border: 1px solid var(--nk-surface-border);
    border-radius: var(--nk-radius-card);
    padding: 14px 16px;
    display: grid;
    gap: 4px;
    transition: border-color 0.2s ease;
  }

  .nk-pipeline__agent:hover {
    border-color: color-mix(in srgb, var(--nk-mint) 45%, var(--nk-surface-border));
  }

  .nk-pipeline__agent-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nk-pipeline__glyph {
    font-size: 1rem;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    border: 1px solid var(--nk-surface-border);
    background: var(--nk-bg-2);
  }

  [data-agent="planner"] .nk-pipeline__glyph {
    color: var(--nk-agent-planner);
  }
  [data-agent="coder"] .nk-pipeline__glyph {
    color: var(--nk-agent-coder);
  }
  [data-agent="tester"] .nk-pipeline__glyph {
    color: var(--nk-agent-tester);
  }
  [data-agent="reviewer"] .nk-pipeline__glyph {
    color: var(--nk-agent-reviewer);
  }

  .nk-pipeline__agent-name {
    color: var(--nk-text-primary);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .nk-pipeline__state {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--nk-font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--nk-radius-pill);
    border: 1px solid var(--nk-surface-border);
    color: var(--nk-text-muted);
  }

  .nk-pipeline__state--complete {
    color: var(--nk-mint);
    border-color: color-mix(in srgb, var(--nk-mint) 30%, transparent);
    background: color-mix(in srgb, var(--nk-mint) 7%, transparent);
  }

  .nk-pipeline__state--reviewing {
    color: var(--nk-magenta);
    border-color: color-mix(in srgb, var(--nk-magenta) 35%, transparent);
    background: color-mix(in srgb, var(--nk-magenta) 8%, transparent);
  }

  .nk-pipeline__state--running {
    color: var(--nk-warn);
    border-color: color-mix(in srgb, var(--nk-warn) 35%, transparent);
  }

  .nk-pipeline__state--running .nk-dot {
    animation: nk-blink 1.2s ease-in-out infinite;
  }

  @keyframes nk-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  .nk-pipeline__agent-desc {
    font-size: 0.8125rem;
    color: var(--nk-text-secondary);
  }

  .nk-pipeline__agent-detail {
    font-size: 0.75rem;
    color: var(--nk-text-muted);
  }

  /* ---- verified branch end ---- */
  .nk-pipeline__end {
    background: color-mix(in srgb, var(--nk-mint) 6%, var(--nk-bg-1));
    border: 1px solid color-mix(in srgb, var(--nk-mint) 40%, var(--nk-surface-border));
    border-radius: var(--nk-radius-card);
    padding: 16px;
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  .nk-pipeline__end-badge {
    color: var(--nk-mint);
    font-weight: 600;
    font-size: 0.9375rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nk-pipeline__end-branch {
    color: var(--nk-text-primary);
    font-size: 0.8125rem;
  }

  .nk-pipeline__end-artifacts {
    color: var(--nk-text-muted);
    font-size: 0.75rem;
  }

  .nk-pipeline__hint {
    font-size: 0.75rem;
    color: var(--nk-text-muted);
    letter-spacing: 0.03em;
    text-align: center;
  }

  /* ---- Horizontal on large desktop ---- */
  @media (min-width: 1100px) {
    .nk-pipeline__track {
      flex-direction: row;
      align-items: stretch;
      max-width: none;
      width: 100%;
      gap: 0;
    }

    .nk-pipeline__start {
      flex: 0 1 170px;
      min-width: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      border-radius: var(--nk-radius-card);
    }

    .nk-pipeline__start-text {
      white-space: normal;
    }

    .nk-pipeline__conn {
      padding: 0 4px;
      flex: 1 1 24px;
      min-width: 12px;
      align-self: center;
    }

    .nk-pipeline__conn-line {
      width: 100%;
      height: 1px;
    }

    .nk-pipeline__conn-line::after {
      animation: none;
      display: none;
    }

    /* horizontal flow pulse */
    .nk-pipeline__conn-line {
      background: linear-gradient(
        to right,
        var(--nk-surface-border),
        color-mix(in srgb, var(--nk-mint) 55%, var(--nk-surface-border))
      );
      position: relative;
    }

    .nk-pipeline__agent {
      flex: 1 1 180px;
      min-width: 0;
    }

    .nk-pipeline__agent-head {
      flex-wrap: wrap;
    }

    .nk-pipeline__end {
      flex: 1 1 190px;
      min-width: 0;
    }

    .nk-pipeline__end-artifacts {
      font-size: 0.6875rem;
      overflow-wrap: break-word;
    }
  }
</style>
